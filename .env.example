# ================================================================
# 配置模板
# 使用方法：复制本文件为 .env，填入你的真实配置
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ================================================================

# ---- MQTT ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=你的MQTT用户名
MQTT_PASSWORD=你的MQTT密码
MQTT_TOPIC=airport/sensor

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=airport_system

# ---- InfluxDB ----
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=你的InfluxDB_Token
INFLUX_ORG=monior
INFLUX_BUCKET=sensor_data

# ---- 服务 ----
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
